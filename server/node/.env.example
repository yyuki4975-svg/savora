# Copy the values into the API process environment. Do not commit real values.
# PostgreSQL is the canonical catalog. The HTTP API is read-only; offline tools write explicitly.
SAVORA_DATABASE_URL=postgres://savora_app:replace_me@localhost:5432/savora

# Development enables /openapi/v1.json and local operator Draft review routes.
SAVORA_ENVIRONMENT=Development

# Local API port.
PORT=5094
SAVORA_BIND_HOST=127.0.0.1

# Host-header allowlist.
SAVORA_ALLOWED_HOSTS=cookwsavora.com;api.cookwsavora.com;localhost

# Production behind a TLS-terminating proxy: set to the proxy hop count or "loopback".
# SAVORA_TRUST_PROXY=1
# Production: HTTPS port to redirect plain-HTTP requests to (ASP.NET UseHttpsRedirection).
# SAVORA_HTTPS_PORT=443

# Additive product accounts (default off). New SQL migrations must be reviewed/applied separately.
# Production activation is intentionally blocked pending launch acceptance.
SAVORA_PRODUCT_ENABLED=false
# SAVORA_WEB_ORIGIN=http://localhost:5173
# SAVORA_CSRF_KEY=<separate-32-byte-hex-secret-from-secret-store>
# SAVORA_MAIL_KEYS={"k1":"<32-byte-hex-secret-from-secret-store>"}
# SAVORA_MAIL_CURRENT_KEY=k1
# Provider: Resend. Manual adapter implemented; actual delivery/scheduling NOT accepted.
# The local launcher loads product/mail settings from .env.product.local for start/mail:deliver only.
# See product-mail.example and docs/handoff/MAIL_RESEND_SETUP.md. Never log secrets/payloads.
# Explicit delivery switch stays false until a live test is separately authorized.
SAVORA_MAIL_DELIVERY_ENABLED=false
# RESEND_API_KEY=<domain-restricted-sending-key-in-secret-store>
# SAVORA_MAIL_FROM=Savora <accounts@mail.cookwsavora.com>

# Local translation pilot. Put the real key in server/node/.env.local (gitignored),
# never in a frontend environment variable. The local launcher loads it for API start only.
# Dedicated OpenRouter key: default total limit $10, owner-authorized maximum $15.
# Match SAVORA_TRANSLATION_BUDGET_USD to that total; no reset or automatic recharge.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SAVORA_TRANSLATION_MODEL=google/gemini-3.8-flash
# Target Simplified Chinese uses Qwen; other target languages keep Gemini.
SAVORA_TRANSLATION_ZH_MODEL=qwen/qwen3.8-flash
# Explicit authorized backup for recurring Qwen 3.8 rate limits: qwen/qwen3.7-flash.
# Never retry a paid POST or change models automatically; preserve saved drafts and provenance.
SAVORA_TRANSLATION_BUDGET_USD=10
# Optional existing workstation HTTP proxy; local launcher scopes it to the API child.
# Requires a Node release supporting --use-env-proxy. Never disable TLS verification.
# SAVORA_TRANSLATION_PROXY_URL=http://127.0.0.1:7897
