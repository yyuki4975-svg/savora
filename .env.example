# Translation credentials belong exclusively in server/node/.env.local.
# /api/translate proxies to the local Node API; there is no frontend API key.
# Server-rendered canonical catalog, served by the local Node.js API.
SAVORA_CATALOG_API_ENABLED=true
SAVORA_API_BASE_URL=http://localhost:5094
# Local parity preview for imported Draft recipes. Production builds always ignore this flag.
SAVORA_DRAFT_CATALOG_ENABLED=false

# Optional email/password account BFF. No credentials belong in frontend settings.
# Set these in the frontend launcher environment, then restart/rebuild Vinext.
SAVORA_ACCOUNT_API_ENABLED=false
SAVORA_ACCOUNT_API_BASE_URL=http://127.0.0.1:5094
SAVORA_ACCOUNT_WEB_ORIGIN=http://localhost:5173
# Must remain false until real provider delivery has passed acceptance.
SAVORA_ACCOUNT_MAIL_DELIVERY_READY=false

# Public origin used by sitemap.xml and robots.txt (no trailing slash).
SAVORA_SITE_URL=https://cookwsavora.com
